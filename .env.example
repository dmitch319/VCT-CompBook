# Copy to .env and fill in. .env is git-ignored; never commit real credentials.
# In GitHub Actions these come from repository secrets instead.

# --- Postgres container (docker compose uses these to create the local database) ---
POSTGRES_USER=vct
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vct
POSTGRES_PORT=5432

# --- Pipeline / API ---
# libpq connection string read by psycopg. Must match the values above when using the
# local compose database; point it at the hosted database in production.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME

# Self-hosted vlrggapi started by docker compose
VLRGGAPI_PORT=3001
VLRGGAPI_URL=http://localhost:3001
